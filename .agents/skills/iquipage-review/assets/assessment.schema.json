{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IQUIPAGE integration assessment v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "baseline",
    "scope",
    "coverage",
    "checks",
    "dimensions",
    "findings",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "integration-review"
    },
    "baseline": {
      "type": "object",
      "required": [
        "ds_archive_sha256",
        "app_fingerprint"
      ],
      "properties": {
        "ds_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "app_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "approval_ref",
        "surface_ids",
        "required_check_ids",
        "required_dimensions"
      ],
      "properties": {
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_dimensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "visual",
              "ux",
              "code",
              "accessibility",
              "human-agent",
              "performance"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface_id",
          "status",
          "check_ids",
          "evidence"
        ],
        "properties": {
          "surface_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "surface_id",
          "status",
          "app_fingerprint",
          "expected",
          "actual",
          "environment",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "surface_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "app_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "minProperties": 1
          },
          "reason": {
            "type": "string"
          },
          "approval_ref": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "classification",
          "status",
          "title",
          "surface_ids",
          "reproduction",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "classification": {
            "enum": [
              "confirmed",
              "hypothesis"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "accepted-risk"
            ]
          },
          "title": {
            "type": "string"
          },
          "surface_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reproduction": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "verification_check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "release_ready",
        "summary"
      ],
      "properties": {
        "release_ready": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
