{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kind": {
      "const": "integration-review"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "ds_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "app_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "ds_archive_sha256",
        "app_fingerprint",
        "plan_sha256"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "plan_id",
        "plan_revision",
        "surface_ids"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "screenshot",
              "trace",
              "log",
              "source-review",
              "api-observation",
              "measurement"
            ]
          },
          "app_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ds_archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "kind",
          "app_fingerprint",
          "ds_archive_sha256",
          "captured_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surface_id": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "visual",
                "ux",
                "code",
                "accessibility",
                "human-agent",
                "performance"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "app_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ds_archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "method": {
            "enum": [
              "automated",
              "manual-inspection",
              "manual-interaction"
            ]
          },
          "environment": {
            "type": "object",
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "theme": {
                "enum": [
                  "light",
                  "dark",
                  "not-applicable"
                ]
              },
              "viewport": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                ]
              },
              "input": {
                "type": "string",
                "minLength": 1
              },
              "load_mode": {
                "enum": [
                  "application",
                  "fixture",
                  "static"
                ]
              },
              "data_profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "engine",
              "role",
              "theme",
              "viewport",
              "input",
              "load_mode",
              "data_profile"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "string",
            "minLength": 3
          },
          "actual": {
            "type": "string",
            "minLength": 3
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "executed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "surface_id",
          "dimensions",
          "status",
          "app_fingerprint",
          "ds_archive_sha256",
          "method",
          "environment",
          "expected",
          "actual",
          "reason",
          "approval_ref",
          "executed_at",
          "evidence_ids",
          "finding_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "surface_id",
          "status",
          "check_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "visual",
              "ux",
              "code",
              "accessibility",
              "human-agent",
              "performance"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 3
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "approval_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "summary",
          "check_ids",
          "approval_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "classification": {
            "enum": [
              "confirmed",
              "hypothesis"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "accepted-risk",
              "dismissed"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "surface_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "visual",
                "ux",
                "code",
                "accessibility",
                "human-agent",
                "performance"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "detected_at": {
            "type": "string",
            "minLength": 1
          },
          "detected_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reproduction": {
            "type": "string",
            "minLength": 3
          },
          "recommendation": {
            "type": "string",
            "minLength": 3
          },
          "acceptance": {
            "type": "string",
            "minLength": 3
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "related_check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "repair": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 3
                  },
                  "changed_paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "app_fingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "verified_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_check_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "description",
                  "changed_paths",
                  "app_fingerprint",
                  "verified_at",
                  "verification_check_ids"
                ],
                "additionalProperties": false
              }
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "dismissal": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 3
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewed_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_check_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "reason",
                  "reviewer",
                  "reviewed_at",
                  "verification_check_ids"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "classification",
          "status",
          "category",
          "title",
          "surface_ids",
          "dimensions",
          "detected_at",
          "detected_fingerprint",
          "reproduction",
          "recommendation",
          "acceptance",
          "evidence_ids",
          "related_check_ids",
          "repair",
          "owner",
          "approval_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "verdict": {
      "type": "object",
      "properties": {
        "scope_ready": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 3
        }
      },
      "required": [
        "scope_ready",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "baseline",
    "scope",
    "evidence",
    "checks",
    "coverage",
    "dimensions",
    "findings",
    "verdict"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IQUIPAGE assessment 2.0 — not a deployment authorization"
}
