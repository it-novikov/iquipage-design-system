{
  "name": "@sprintique/product",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/build-assets.mjs && node scripts/export-openapi.mjs",
    "start": "node build/backend/main.js",
    "worker": "node build/backend/worker.js",
    "local:storage": "node scripts/local-storage.mjs",
    "local:identity": "node scripts/local-identity.mjs",
    "local:start": "node scripts/local-app.mjs",
    "dev": "vite --host 127.0.0.1",
    "migrate": "tsx backend/migrate.ts",
    "test": "node scripts/test.mjs",
    "preview:fixture": "node scripts/test.mjs --preview",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@iquipage/web": "file:vendor/iquipage-web-0.6.0-vnext.1.tgz",
    "fastify": "5.12.4",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
