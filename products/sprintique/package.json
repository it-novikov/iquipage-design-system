{
  "name": "@sprintique/product",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "java -jar server/build/libs/sprintique-server.jar api",
    "worker": "java -jar server/build/libs/sprintique-server.jar worker",
    "local:storage": "node scripts/local-storage.mjs",
    "local:services": "node scripts/local-services.mjs",
    "local:check-sign-in": "node scripts/check-local-sign-in.mjs",
    "local:start": "node scripts/local-app.mjs",
    "dev": "vite --host 127.0.0.1",
    "migrate": "java -jar server/build/libs/sprintique-server.jar migrate",
    "contracts": "tsx scripts/export-contracts.ts",
    "test": "node scripts/test.mjs",
    "preview:fixture": "node scripts/test.mjs --preview",
    "dev:local": "node scripts/test.mjs --preview",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-styles.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "preview:settings": "node scripts/test.mjs --settings-preview",
    "build:server": "cd server && ./gradlew check bootJar",
    "build:image": "npm run build && cd server && ./gradlew jibBuildTar"
  },
  "dependencies": {
    "@iquipage/web": "file:vendor/iquipage-web-0.6.0-vnext.51.tgz",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
