{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"], "types": ["node"], "noEmit": true
  },
  "include": ["backend/**/*.ts", "contracts/**/*.ts", "client/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
