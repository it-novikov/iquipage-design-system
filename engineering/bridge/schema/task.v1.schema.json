{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iquipage.dev/schemas/bridge/task.v1.json",
  "title": "Bridge task card, format 1",
  "description": "A task card as data. `bridge show --json` emits this read-only projection; the Markdown card is the source of truth. Sprintique's task work plan follows the same model (see products/sprintique/docs/agent-bridge.md for the fields that map to platform entities).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "status",
    "risk",
    "goal",
    "scope",
    "acceptance",
    "handoff",
    "steps",
    "decisions",
    "questions"
  ],
  "properties": {
    "format": {
      "const": "bridge/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*$|^[A-Za-z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "active",
        "blocked",
        "review",
        "done",
        "cancelled"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "standard",
        "high"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "base": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "links": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "goal": {
      "type": "string",
      "maxLength": 4000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "constraints"
      ],
      "properties": {
        "included": {
          "type": "string",
          "maxLength": 4000
        },
        "excluded": {
          "type": "string",
          "maxLength": 4000
        },
        "constraints": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "acceptance": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "done"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "current",
        "next",
        "uncommitted",
        "workingCopy",
        "traps",
        "verify",
        "reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "maxLength": 2000
        },
        "current": {
          "type": "string",
          "maxLength": 1000
        },
        "next": {
          "type": "string",
          "maxLength": 1000
        },
        "uncommitted": {
          "type": "string",
          "maxLength": 2000
        },
        "traps": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "verify": {
          "type": "string",
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "workingCopy": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "what",
          "how",
          "why",
          "criteria",
          "result",
          "dependsOn",
          "model",
          "covers",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "todo",
              "active",
              "done",
              "blocked",
              "dropped"
            ]
          },
          "what": {
            "type": "string",
            "maxLength": 2000
          },
          "how": {
            "type": "string",
            "maxLength": 4000
          },
          "why": {
            "type": "string",
            "maxLength": 2000
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "done"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "done": {
                  "type": "boolean"
                }
              }
            }
          },
          "result": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{1,3}$"
            }
          },
          "model": {
            "enum": [
              "strong",
              "fast",
              null
            ]
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A[0-9]{1,3}$"
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[0-9]+$"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "text",
          "to",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "status": {
            "enum": [
              "open",
              "answered"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    },
    "context": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "extraSections": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "text"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    }
  }
}
