{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iquipage.dev/schemas/bridge/task.v1.json",
  "title": "Bridge task card, format 1",
  "description": "A task card as data. `bridge show --json` emits it; Sprintique's task work plan API reads and writes the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "title", "status", "risk", "goal", "scope", "handoff", "steps", "decisions", "questions"],
  "properties": {
    "format": {"const": "bridge/1"},
    "id": {"type": "string", "pattern": "^[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*$|^[A-Za-z0-9_-]{1,64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "status": {"enum": ["draft", "ready", "active", "blocked", "review", "done", "cancelled"]},
    "risk": {"enum": ["low", "standard", "high"]},
    "owner": {"type": ["string", "null"], "maxLength": 200},
    "holder": {"type": ["string", "null"], "maxLength": 200},
    "lease": {"type": ["string", "null"], "format": "date-time"},
    "branch": {"type": ["string", "null"], "maxLength": 200},
    "base": {"type": ["string", "null"], "maxLength": 200},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date-time"},
    "links": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 2000}},
    "goal": {"type": "string", "maxLength": 4000},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["included", "excluded", "constraints"],
      "properties": {
        "included": {"type": "string", "maxLength": 4000},
        "excluded": {"type": "string", "maxLength": 4000},
        "constraints": {"type": "string", "maxLength": 4000}
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "current", "next", "uncommitted", "traps", "verify", "reason"],
      "properties": {
        "state": {"type": "string", "maxLength": 2000},
        "current": {"type": "string", "maxLength": 1000},
        "next": {"type": "string", "maxLength": 1000},
        "uncommitted": {"type": "string", "maxLength": 2000},
        "traps": {"type": "array", "maxItems": 40, "items": {"type": "string", "maxLength": 500}},
        "verify": {"type": "string", "maxLength": 1000},
        "reason": {"type": "string", "maxLength": 500}
      }
    },
    "steps": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "status", "what", "how", "why", "criteria", "result", "dependsOn", "model"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{1,3}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"enum": ["todo", "active", "done", "blocked", "dropped"]},
          "what": {"type": "string", "maxLength": 2000},
          "how": {"type": "string", "maxLength": 4000},
          "why": {"type": "string", "maxLength": 2000},
          "criteria": {
            "type": "array", "minItems": 1, "maxItems": 30,
            "items": {"type": "object", "additionalProperties": false, "required": ["text", "done"],
              "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 500}, "done": {"type": "boolean"}}}
          },
          "result": {"type": ["string", "null"], "maxLength": 2000},
          "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}},
          "model": {"enum": ["strong", "fast", null]}
        }
      }
    },
    "decisions": {
      "type": "array", "maxItems": 200,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "date", "text"],
        "properties": {"id": {"type": "string", "pattern": "^D[0-9]+$"}, "date": {"type": ["string", "null"], "format": "date"}, "text": {"type": "string", "maxLength": 2000}}}
    },
    "questions": {
      "type": "array", "maxItems": 200,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "text", "to", "answer"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q[0-9]+$"},
          "status": {"enum": ["open", "answered"]},
          "text": {"type": "string", "maxLength": 2000},
          "to": {"type": ["string", "null"], "maxLength": 200},
          "answer": {"type": ["string", "null"], "maxLength": 2000}
        }}
    },
    "context": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1000}}
  }
}
