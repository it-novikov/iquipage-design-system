{
  "name": "@iquipage/web",
  "version": "0.6.0-vnext.35",
  "private": true,
  "type": "module",
  "description": "IQUIPAGE standalone Web Components library",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/iquipage.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./advanced": {
      "types": "./types/extensions.d.ts",
      "import": "./dist/advanced.js"
    },
    "./whiteboard": {
      "types": "./types/whiteboard.d.ts",
      "import": "./dist/whiteboard.js"
    },
    "./styles.css": "./dist/iquipage.css",
    "./fonts.css": "./tokens/fonts.css",
    "./tokens": "./tokens/semantic.json",
    "./theme-boot.js": "./dist/theme-boot.js",
    "./work-list": {
      "types": "./types/work-list.d.ts",
      "import": "./dist/work-list.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "prepack": "node scripts/build.mjs",
    "gates:update": "node scripts/gates/update.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "types",
    "tokens",
    "assets/icons",
    "assets/fonts",
    "LICENSE",
    "README.md",
    "PROVENANCE.json",
    "docs/authentication.md",
    "examples/authentication.html",
    "docs/workspace.md"
  ]
}
