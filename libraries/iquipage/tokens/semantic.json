  "meta": {
    "name": "IQUIPAGE Design System",
    "version": "0.6.0-vnext.1",
    "status": "source-owned-library",
    "basis": "Approved 05.6 foundation; repaired workshop, capture, tooltips, shapes and connections",
    "palette": {
      "colorSource": "tokens/semantic.json",
      "allCSSHexCentralized": true,
      "fixedRoles": "Existing 04.8 roles preserved. Task lighting uses explicit per-theme alpha tokens and a neutral base."
